#!/usr/bin/env bash
# Page the owner that a unit failed (cryptolab-alert@<unit>.service, OnFailure=). Reads only the shared host's
# paging file (/etc/wt/paging: the ntfy topic), so it works when the secrets fetch is what failed. Reads it and
# nothing more. Never fails its caller.
set -uo pipefail
unit="${1:-a unit}"
topic=""
server="https://ntfy.sh"
if [[ -r /etc/wt/paging ]]; then
  topic=$(sed -n 's/^NTFY_TOPIC=//p' /etc/wt/paging | head -1)
  s=$(sed -n 's/^NTFY_SERVER=//p' /etc/wt/paging | head -1); [[ -n "$s" ]] && server="$s"
fi
if [[ -z "$topic" ]]; then
  echo "cryptolab-alert: no ntfy topic configured; $unit failed" >&2
  exit 0
fi
curl -fsS --max-time 10 -H "Title: Crypto Lab: ${unit%.service} failed" -H "Priority: 4" \
  -d "systemd reports ${unit} failed on $(hostname -s). Check: journalctl -u ${unit} and make -C /home/wt/crypto-lab status." \
  "${server%/}/${topic}" >/dev/null || echo "cryptolab-alert: ntfy unreachable; $unit failed" >&2
exit 0
