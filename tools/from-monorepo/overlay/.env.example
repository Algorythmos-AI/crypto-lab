# A development machine needs none of these: the tests use fixtures and temp directories only, and the desk
# reads public market data without a key. There is no venue credential, and none may be added.
#
# On the host the values come from the shared secrets file (WT_ENV_FILE=/run/wt-secrets/env), never from here.
# What this repository reads from it:

# The dashboard that receives the desk's snapshot (HMAC-signed POST). Without both, a publish builds and
# validates the snapshot and sends nothing.
DASHBOARD_INGEST_URL=
DASHBOARD_INGEST_SECRET=
VERCEL_AUTOMATION_BYPASS_SECRET=

# Paging (ntfy) and dead-man checks (healthchecks.io). Without them alerts and pings are simply off.
NTFY_TOPIC=
HC_PING_KEY=

# The daily backup: a restic repository on R2 and the write-once anchor bucket.
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
